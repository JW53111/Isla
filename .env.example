# Image generation API configuration
# Required for generating pet action sprites.
IMAGE_API_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=YOUR_IMAGE_API_KEY
IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1536x1024
IMAGE_QUALITY=high
IMAGE_N=1

# Optional text model configuration
# Only needed if you use additional automation or web flows that call a text API.
TEXT_API_BASE_URL=
TEXT_API_KEY=
TEXT_MODEL=gpt-5.5
